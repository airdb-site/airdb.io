---
import ProductLayout from "../../layouts/ProductLayout.astro";
---

<ProductLayout
  title="Discuss API access — AirDB"
  description="Prepare an email inquiry about AirDB API access or a trial. Availability and next steps must be confirmed by email."
  path="/get-access/"
>
  <div class="shell page-hero">
    <p class="notice">Early access · email inquiry</p>
    <h1>Discuss API access</h1>
    <p class="lede">
      Prepare an email describing what you are building. This page does not submit requests or issue API keys.
      Contact us by email to confirm availability.
    </p>
  </div>

  <div class="shell form-wrap">
    <form
      name="api-access"
      id="access-draft"
      class="form-grid"
    >
      <div class="field">
        <label for="name">Name <span class="req">*</span></label>
        <input id="name" name="name" type="text" required autocomplete="name" />
      </div>

      <div class="field">
        <label for="email">Work email <span class="req">*</span></label>
        <input id="email" name="email" type="email" required autocomplete="email" />
        <p class="hint">An address where we can reply to your inquiry.</p>
      </div>

      <div class="field">
        <label for="company">Company / organization</label>
        <input id="company" name="company" type="text" autocomplete="organization" />
      </div>

      <div class="field">
        <label for="plan">Plan you are interested in <span class="req">*</span></label>
        <select id="plan" name="plan" required>
          <option value="developer">Developer (free)</option>
          <option value="team">Team ($99 / month, 14-day trial)</option>
          <option value="enterprise">Enterprise (custom)</option>
        </select>
        <p class="hint">Selecting a plan only adds it to your inquiry. Access and trial availability must be confirmed by email.</p>
      </div>

      <div class="field">
        <label for="usecase">What are you building?</label>
        <textarea
          id="usecase"
          name="usecase"
          placeholder="e.g. procurement dashboard for a fruit supply chain; needs daily wholesale prices for East China"
        ></textarea>
      </div>

      <button class="btn btn-solid" type="button" id="prepare-email">Prepare email</button>
      <p class="hint">
        Prefer email? Write to <a href="mailto:info@airdb.com">info@airdb.com</a>.
        Nothing is sent until you send the message from your email app.
      </p>
      <p id="draft-result" class="hint" role="status" hidden><a id="draft-link" href="mailto:info@airdb.com">Open email draft</a>. Review and send it in your email app. No request has been received and no access or trial has been activated by this page.</p>
    </form>
    <noscript><style>#access-draft { display: none; }</style><p>Email your access request to <a href="mailto:info@airdb.com">info@airdb.com</a>.</p></noscript>
  </div>

  <script>
    const form = document.querySelector<HTMLFormElement>('#access-draft');
    form?.addEventListener('submit', (event) => event.preventDefault());
    document.getElementById('prepare-email')?.addEventListener('click', () => {
      if (!form?.reportValidity()) return;
      const values = new FormData(form);
      const body = ['name', 'email', 'company', 'plan', 'usecase'].map((key) => `${key}: ${values.get(key) ?? ''}`).join('\n');
      const link = document.querySelector<HTMLAnchorElement>('#draft-link');
      if (link) link.href = `mailto:info@airdb.com?subject=${encodeURIComponent('AirDB API access inquiry')}&body=${encodeURIComponent(body)}`;
      const result = document.getElementById('draft-result');
      if (result) result.hidden = false;
    });

    // Pre-select the plan from ?plan= links on the pricing section
    const plan = new URLSearchParams(location.search).get("plan");
    const select = document.getElementById("plan") as HTMLSelectElement | null;
    if (plan && select && [...select.options].some((o) => o.value === plan)) {
      select.value = plan;
    }
  </script>
</ProductLayout>
